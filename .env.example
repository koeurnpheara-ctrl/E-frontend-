# Copy to .env and replace the example secrets before starting Docker Compose.
FRONTEND_PORT=80
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000/api
VITE_PRODUCTS_ENDPOINT=/products
VITE_CATEGORIES_ENDPOINT=/categories

# Replace these values with unique secrets before starting the services.
POSTGRES_PASSWORD=replace-with-a-strong-database-password
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-password-at-least-12-characters
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://localhost
